with "giflib_whitebox.gpr";

project Unit_Tests extends "tests_common.gpr" is
   for Source_Dirs use ("src", "src/subunits", "src/mains");
   for Main use ("giflib_tests.adb");
   case Tests_Common.Selected_Build_Profile is
      when "release" =>
         for Object_Dir use "obj/unit-tests-release";
         for Exec_Dir use "bin/release";
      when "validation" =>
         for Object_Dir use "obj/unit-tests-validation";
         for Exec_Dir use "bin/validation";
      when "development" =>
         for Object_Dir use "obj/unit-tests";
         for Exec_Dir use "bin";
   end case;
end Unit_Tests;
