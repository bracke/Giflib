with "config/tests_config.gpr";
with "../giflib_build.gpr";

--  Test-only build of the production sources.  The installed Giflib project
--  exposes only its supported Library_Interface; this project deliberately
--  leaves every internal unit visible to white-box tests.
library project Giflib_Whitebox is
   Selected_Build_Profile : Tests_Config.Build_Profile_Kind :=
     External ("GIFLIB_BUILD_PROFILE_OVERRIDE", Tests_Config.Build_Profile);
   for Source_Dirs use ("../src");
   for Library_Name use "giflib_whitebox";
   for Library_Kind use "static";
   for Create_Missing_Dirs use "True";

   case Selected_Build_Profile is
      when "release" =>
         for Object_Dir use "obj/giflib-whitebox-release";
         for Library_Dir use "lib/whitebox-release";
      when "validation" =>
         for Object_Dir use "obj/giflib-whitebox-validation";
         for Library_Dir use "lib/whitebox-validation";
      when "development" =>
         for Object_Dir use "obj/giflib-whitebox";
         for Library_Dir use "lib/whitebox";
   end case;

   package Compiler is
      case Selected_Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use
              Giflib_Build.Release_Switches;
         when "validation" =>
            for Default_Switches ("Ada") use
              Giflib_Build.Validation_Switches;
         when "development" =>
            for Default_Switches ("Ada") use
              Giflib_Build.Development_Switches;
      end case;
   end Compiler;
end Giflib_Whitebox;
