with "config/giflib_config.gpr";
with "giflib_build.gpr";

library project Giflib is
   Selected_Build_Profile : Giflib_Config.Build_Profile_Kind :=
     External ("GIFLIB_BUILD_PROFILE_OVERRIDE", Giflib_Config.Build_Profile);
   for Source_Dirs use ("src");
   case Selected_Build_Profile is
      when "release" =>
         for Object_Dir use "obj/giflib-release";
         for Library_Dir use "lib/release";
      when "validation" =>
         for Object_Dir use "obj/giflib-validation";
         for Library_Dir use "lib/validation";
      when "development" =>
         for Object_Dir use "obj/giflib";
         for Library_Dir use "lib";
   end case;
   for Library_Name use "giflib";
   for Library_Kind use "static";
   --  Keep implementation children out of the compiled library interface.
   --  White-box tests use a separate project; installed clients can only
   --  depend on the supported units listed here.
   for Library_Interface use
     ("Giflib",
      "Giflib.Animations",
      "Giflib.Capabilities",
      "Giflib.Decoding",
      "Giflib.Encoding",
      "Giflib.Errors",
      "Giflib.Frames",
      "Giflib.Images",
      "Giflib.Limits",
      "Giflib.Metadata",
      "Giflib.Optimization",
      "Giflib.Palettes",
      "Giflib.Quantization",
      "Giflib.Results",
      "Giflib.Streams",
      "Giflib.Version",
      --  Private semantic closure of the public limited-private types.  These
      --  units remain inaccessible to clients because Giflib.Internal itself
      --  is a private child.
      "Giflib.Internal",
      "Giflib.Internal.Blocks",
      "Giflib.Internal.Borrow_Guards",
      "Giflib.Internal.Budget_Arithmetic",
      "Giflib.Internal.Decoder_Storage",
      "Giflib.Internal.Encoder_Storage",
      "Giflib.Internal.LZW",
      "Giflib.Internal.LZW_Arithmetic",
      "Giflib.Internal.LZW_Encoding",
      "Giflib.Internal.Metadata_Store",
      "Giflib.Internal.Owned_Arrays",
      "Giflib.Internal.Owned_Buffers",
      "Giflib.Internal.Owned_Element_Vectors",
      "Giflib.Internal.Owned_Objects",
      "Giflib.Internal.Owned_Vectors",
      "Giflib.Internal.Ownership",
      "Giflib.Internal.Ownership_Arithmetic",
      "Giflib.Internal.Quantization_Buffer_Arithmetic",
      "Giflib.Internal.Quantization_Dithering",
      "Giflib.Internal.Quantization_Palette",
      "Giflib.Internal.Quantization_Storage",
      "Giflib.Internal.Work_Budgets");
   for Create_Missing_Dirs use "True";

   package Compiler is
      case Selected_Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use
              Giflib_Build.Release_Switches;
         when "validation" =>
            for Default_Switches ("Ada") use
              Giflib_Build.Validation_Switches;
         when "development" =>
            for Default_Switches ("Ada") use
              Giflib_Build.Development_Switches;
      end case;
   end Compiler;
end Giflib;
